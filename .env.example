DATABASE_URL="file:./dev.db"

# Required if you connect Google Drive: encrypts the stored OAuth tokens at
# rest (AES-256-GCM). Any long random string works — e.g. `openssl rand -hex 32`.
# Rotating this key invalidates any already-stored Drive connection (you'll
# need to reconnect from Admin > Google Drive).
ENCRYPTION_KEY=""

# Google Drive integration (Admin > Google Drive) — optional. Leave unset and
# the feature just shows "not configured" instead of erroring.
#
# Setup: Google Cloud Console > APIs & Services
#   1. Create a project (or use an existing one) and enable the Google Drive API.
#   2. Configure the OAuth consent screen (internal or external; add the
#      scope https://www.googleapis.com/auth/drive.readonly).
#   3. Create an OAuth client ID of type "Web application".
#   4. Add an Authorized redirect URI matching GOOGLE_REDIRECT_URI below
#      exactly (protocol, host and path all have to match).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/admin/drive/callback"
