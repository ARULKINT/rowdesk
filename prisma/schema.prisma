generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         String   @default("DATA_PROCESSOR") // ADMIN | DATA_PROCESSOR
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions              Session[]
  claimedRecords        Record[]                @relation("ClaimedRecords")
  doneRecords           Record[]                @relation("DoneRecords")
  auditLogs             AuditLog[]
  createdTemplates      Template[]
  driveConnections      GoogleDriveConnection[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model SourceFile {
  id         String   @id @default(cuid())
  filename   String
  importedAt DateTime @default(now())

  totalRows           Int @default(0) // rows read from the CSV, before cleaning
  removedMissingName  Int @default(0)
  removedMissingPhone Int @default(0)

  importedVia String @default("manual") // manual | drive

  driveFileId String?
  driveFile   DriveFile? @relation(fields: [driveFileId], references: [id])

  records Record[]
}

model GoogleDriveConnection {
  id     String @id @default(cuid())
  singleton Boolean @unique @default(true) // enforces at most one row

  connectedByUserId String
  connectedBy       User   @relation(fields: [connectedByUserId], references: [id])

  googleEmail String

  // AES-256-GCM encrypted at rest via ENCRYPTION_KEY (see src/lib/encryption.ts).
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime

  folderId   String?
  folderName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DriveFile {
  id          String @id @default(cuid())
  driveFileId String @unique
  filename    String

  driveModifiedAt      DateTime
  lastProcessedAt      DateTime?
  lastProcessedVersion DateTime? // driveModifiedAt as of the last successful import

  status       String  @default("new") // new | updated | unchanged | processing | processed | error
  errorMessage String?

  sourceFiles SourceFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Record {
  id       String @id @default(cuid())
  rowIndex Int

  name       String
  phone      String?
  rating     Float?
  mapsUrl    String?
  websiteUrl String?

  called   Boolean @default(false)
  verified Boolean @default(false)

  status String @default("pending") // pending | done | skipped

  // Outreach sequence: initial -> followup1 -> followup2, each stage gated by
  // a 3-day wait after the previous one was sent. stageDueAt null means the
  // record is due now; findCandidate() hides it from the queue until then.
  outreachStage String    @default("initial") // initial | followup1 | followup2
  stageDueAt    DateTime?

  claimedById String?
  claimedBy   User?     @relation("ClaimedRecords", fields: [claimedById], references: [id])
  claimedAt   DateTime?

  doneById String?
  doneBy   User?     @relation("DoneRecords", fields: [doneById], references: [id])
  doneAt   DateTime?

  sourceFile   SourceFile @relation(fields: [sourceFileId], references: [id])
  sourceFileId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceFileId, rowIndex])
  @@index([status, claimedById])
  @@index([claimedAt])
  @@index([stageDueAt])
}

model TemplateDictionary {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates Template[]
}

model Template {
  id           String             @id @default(cuid())
  dictionaryId String
  dictionary   TemplateDictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  body     String
  position Int
  status   String @default("active") // active | retired

  // Which point in the outreach sequence this template belongs to, and in
  // which language. Existing rows default to initial/english, preserving
  // today's single-stage English behavior unchanged.
  stage    String @default("initial")  // initial | followup1 | followup2
  language String @default("english")  // english | tamil

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dictionaryId, position])
  @@index([dictionaryId, stage, language])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String?
  metadata   String? // JSON-encoded details

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entityType, entityId])
}

model SystemSetting {
  key   String @id
  value String
}
